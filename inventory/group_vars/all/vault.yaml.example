# group_vars/all/vault.yaml 의 평문 예시 (실제 파일은 ansible-vault로 암호화)
#   편집: ansible-vault edit group_vars/all/vault.yaml --vault-password-file vault_password.txt
#   비밀번호 생성: openssl rand -base64 24
#   변수별 넣을 값 / 추천 / 참고 링크: docs/variables.md

# ---------- 01 base ----------
deploy_user: manager
deploy_user_ssh_keys:
  - "ssh-ed25519 AAAA... me@laptop"
# common_apt_upgrade: true
# firewall_allowed_tcp_ports: [80, 443]
# firewall_rules:
#   - { port: 22, from: 203.0.113.0/24 }

# ---------- 02 kubernetes (필수 값 없음, 원격 kubectl 쓸 때만) ----------
# k8s_api_allowed_sources: [203.0.113.0/24]   # 6443 을 열 출발지
# k8s_api_cert_sans: [k8s.example.com]        # API 인증서에 넣을 도메인/IP
# k8s_ingress_enabled: false                  # 80/443 을 다른 서비스가 쓰면

# ---------- 03 gitea / 04 gitlab 공통 ----------
# traefik_acme_email: you@example.com      # 지정하면 HTTPS (Let's Encrypt 자동 발급/갱신). DNS 가 서버를 가리켜야 함
wharfline_domain: deploy.example.com
wharfline_postgres_password: "<random>"
wharfline_owner_email: you@example.com
wharfline_owner_password: "<10자 이상, 첫 로그인 때 변경>"
# wharfline_master_key: "k20261114...:base64..."   # 첫 실행 후 secrets/<호스트>/ 에 생긴 키를 여기로 옮기기
# wharfline_platform: linux/amd64                   # ARM 서버일 때만

# ---------- 03 gitea ----------
gitea_domain: git.example.com
gitea_db_password: "<random>"
gitea_admin_email: you@example.com
gitea_admin_password: "<8자 이상>"

# ---------- 04 gitlab ----------
gitlab_domain: gitlab.example.com
gitlab_root_password: "<무작위 문자열. 흔한 단어 조합이면 GitLab 이 거부>"
# gitlab_low_memory: false                # 8GB 이상 서버

# ---------- 05 app ----------
# app_registries:
#   - { registry: ghcr.io, username: me, password: "<read:packages 토큰>" }

# ---------- 06 postgres ----------
postgres_superuser_password: "<random>"
postgres_allowed_sources: []               # 예) [10.0.0.0/24]  비우면 서버 내부에서만
postgres_databases: []
#   - { name: app, user: app, password: "<random>" }

# ---------- 07 monitoring ----------
grafana_domain: grafana.example.com
grafana_admin_password: "<8자 이상>"
# alert_slack_webhook_url: "https://hooks.slack.com/services/..."
# alert_telegram_bot_token: "..."     # + alert_telegram_chat_id: 123456789
# alert_webhook_url: "https://..."
# grafana_dashboards: [{ id: 1860, name: node-exporter-full }, { id: 14282, name: cadvisor }]

# ---------- 08 security ----------
# security_disable_password_auth: true    # 인벤토리를 키 접속으로 바꾼 뒤에
# security_whitelist_ips: [203.0.113.10]   # CrowdSec 이 차단하지 않을 관리자 IP/CIDR
# crowdsec_enroll_key: ""                  # app.crowdsec.net 콘솔 연결 (선택)
# crowdsec_collections:                    # 통째로 바뀜. 추천 조합: docs/variables.md
#   - crowdsecurity/linux
#   - crowdsecurity/sshd
#   - crowdsecurity/traefik
#   - crowdsecurity/http-cve
#   - crowdsecurity/base-http-scenarios
#   - crowdsecurity/whitelist-good-actors   # 검색엔진 등 정상 봇 제외
# security_auto_reboot: true

# ---------- 09 middleware ----------
rabbitmq_user: admin
rabbitmq_password: "<random>"
redis_password: "<random>"
middleware_allowed_sources: []             # 예) [10.0.0.0/24]

# ---------- 10 backup ----------
# backup_keep_days: 7
# backup_restic_repository: "s3:https://kr.object.ncloudstorage.com/my-bucket/orca"
# backup_restic_password: "<random. 잃으면 복구 불가>"
# backup_restic_env: { AWS_ACCESS_KEY_ID: "...", AWS_SECRET_ACCESS_KEY: "..." }

# ---------- 12 vpn ----------
# vpn_server_url: vpn.example.com        # 기본 auto (공인 IP 자동 감지)
# vpn_peers: [laptop, phone]
