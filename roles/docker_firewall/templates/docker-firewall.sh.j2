#!/bin/sh
# {{ ansible_managed }}
# /etc/docker-firewall/rules.d/*.rules 를 읽어 DOCKER-USER 체인을 다시 만듭니다.
#   형식: <port> <proto> [허용 CIDR ...]   (CIDR 이 없으면 외부 접근 전부 차단)
set -eu
IF="{{ docker_firewall_interface }}"

iptables -N DOCKER-USER 2>/dev/null || true
iptables -F DOCKER-USER
iptables -A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN

# 1) 모든 파일의 허용 규칙을 먼저, 2) 포트별 차단 규칙은 맨 뒤에 한 번씩
#    (파일마다 DROP 을 붙이면 같은 포트를 다루는 다음 파일의 허용이 막힘)
RULES="$(cat /etc/docker-firewall/rules.d/*.rules 2>/dev/null | grep -vE '^\s*(#|$)' || true)"

echo "$RULES" | while read -r port proto sources; do
  [ -n "$port" ] || continue
  for src in $sources; do
    iptables -A DOCKER-USER -i "$IF" -p "$proto" -m conntrack --ctorigdstport "$port" --ctdir ORIGINAL -s "$src" -j RETURN
  done
done

echo "$RULES" | awk 'NF {print $1, $2}' | sort -u | while read -r port proto; do
  iptables -A DOCKER-USER -i "$IF" -p "$proto" -m conntrack --ctorigdstport "$port" --ctdir ORIGINAL -j DROP
done

iptables -A DOCKER-USER -j RETURN
