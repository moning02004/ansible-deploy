# {{ ansible_managed }}
name: gitea

x-logging: &logging
  driver: json-file
  options: { max-size: "10m", max-file: "5" }

services:
  db:
    image: postgres:16-alpine
    container_name: gitea-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: gitea
      POSTGRES_USER: gitea
      POSTGRES_PASSWORD: ${GITEA_DB_PASSWORD:?}
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U gitea -d gitea"]
      interval: 5s
      timeout: 3s
      retries: 20
    logging: *logging

  gitea:
    image: docker.gitea.com/gitea:{{ gitea_version }}
    container_name: gitea
    restart: unless-stopped
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: db:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWD: ${GITEA_DB_PASSWORD:?}
      GITEA__server__DOMAIN: "{{ gitea_domain }}"
      GITEA__server__SSH_DOMAIN: "{{ gitea_domain }}"
      GITEA__server__ROOT_URL: "{{ gitea_root_url }}"
      GITEA__server__SSH_PORT: "{{ gitea_ssh_port }}"
      GITEA__server__SSH_LISTEN_PORT: "22"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__service__DISABLE_REGISTRATION: "{{ gitea_disable_registration | string | lower }}"
      GITEA__actions__ENABLED: "true"
    volumes:
      - gitea_data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks: [default, {{ traefik_network | default('web') }}]
    labels:
      traefik.enable: "true"
      traefik.http.routers.gitea.rule: "Host(`{{ gitea_domain }}`)"
      traefik.http.services.gitea.loadbalancer.server.port: "3000"
    ports:
      - "127.0.0.1:{{ gitea_http_port }}:3000"
      - "{{ gitea_ssh_port }}:22"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000/api/healthz >/dev/null || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 10
      start_period: 20s
    logging: *logging
{% if gitea_runner_enabled %}

  runner:
    image: docker.gitea.com/act_runner:{{ act_runner_version }}
    container_name: gitea-runner
    restart: unless-stopped
    env_file:
      - path: runner.env
        required: false
    environment:
      GITEA_INSTANCE_URL: http://gitea:3000
      GITEA_RUNNER_NAME: "{{ gitea_runner_name }}"
{% if gitea_runner_labels %}
      GITEA_RUNNER_LABELS: "{{ gitea_runner_labels }}"
{% endif %}
    volumes:
      - runner_data:/data
      - /var/run/docker.sock:/var/run/docker.sock
    depends_on:
      gitea:
        condition: service_healthy
    logging: *logging
{% endif %}

networks:
  default: {}
  {{ traefik_network | default('web') }}:
    external: true

volumes:
  db_data:
  gitea_data:
{% if gitea_runner_enabled %}
  runner_data:
{% endif %}
