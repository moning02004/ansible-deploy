# {{ ansible_managed }}
route:
  receiver: default
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: default
{% if alert_slack_webhook_url %}
    slack_configs:
      - api_url: "{{ alert_slack_webhook_url }}"
        channel: "{{ alert_slack_channel }}"
        send_resolved: true
        title: '{{ '{{' }} .Status | toUpper {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }}'
        text: '{{ '{{' }} range .Alerts {{ '}}' }}{{ '{{' }} .Annotations.summary {{ '}}' }}{{ '{{' }} "\n" {{ '}}' }}{{ '{{' }} end {{ '}}' }}'
{% endif %}
{% if alert_telegram_bot_token %}
    telegram_configs:
      - bot_token: "{{ alert_telegram_bot_token }}"
        chat_id: {{ alert_telegram_chat_id }}
        send_resolved: true
{% endif %}
{% if alert_webhook_url %}
    webhook_configs:
      - url: "{{ alert_webhook_url }}"
        send_resolved: true
{% endif %}

inhibit_rules:
  # 서버가 죽었으면 그 서버의 다른 경보는 보내지 않음
  - source_matchers: [alertname = InstanceDown]
    target_matchers: [severity = warning]
    equal: [instance]
