# {{ ansible_managed }}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ prometheus_port }}"]

  - job_name: node
    static_configs:
{% for h in groups[monitoring_targets] %}
      - targets: ["{{ hostvars[h].ansible_default_ipv4.address }}:{{ hostvars[h].node_exporter_port | default(9100) }}"]
        labels: { instance: "{{ h }}" }
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for h in groups[monitoring_targets] %}
      - targets: ["{{ hostvars[h].ansible_default_ipv4.address }}:{{ hostvars[h].cadvisor_port | default(9280) }}"]
        labels: { instance: "{{ h }}" }
{% endfor %}
