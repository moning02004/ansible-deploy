# {{ ansible_managed }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ site.server_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
{% if tls %}

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ site.server_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ site.server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site.server_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    client_max_body_size {{ site.client_max_body_size | default('64m') }};

    location / {
        proxy_pass {{ site.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
{% if site.sse | default(false) %}
        proxy_buffering off;
        proxy_read_timeout 1h;
{% endif %}
    }
}
