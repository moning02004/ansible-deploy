# {{ ansible_managed }}
name: traefik

services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik
    restart: unless-stopped
    command:
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network={{ traefik_network }}
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --entrypoints.web.transport.respondingTimeouts.readTimeout={{ traefik_read_timeout }}
      - --entrypoints.websecure.transport.respondingTimeouts.readTimeout={{ traefik_read_timeout }}
      - --ping=true
      - --log.level={{ traefik_log_level }}
{% if traefik_access_log %}
      - --accesslog=true
      - --accesslog.filepath=/var/log/traefik/access.log
{% endif %}
{% if traefik_acme_email %}
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.http.tls.certresolver=le
      - --certificatesresolvers.le.acme.email={{ traefik_acme_email }}
      - --certificatesresolvers.le.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.le.acme.httpchallenge.entrypoint=web
{% endif %}
    ports:
      - "80:80"
      - "443:443"
    extra_hosts:
      - "host.docker.internal:host-gateway"   # 호스트 서비스(traefik_file_routes)용
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./dynamic:/etc/traefik/dynamic:ro
      - letsencrypt:/letsencrypt
{% if traefik_access_log %}
      - /var/log/traefik:/var/log/traefik
{% endif %}
    # 서버 안에서 이 도메인들이 Traefik 을 가리키도록 (git.example.com 으로 clone, deploy.example.com 으로 webhook 등)
    networks:
{% for net in [traefik_network] + traefik_network_list %}
      {{ net }}:
        aliases: {{ traefik_alias_list | to_json }}
{% endfor %}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 3s
      retries: 3
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "5" }

networks:
{% for net in [traefik_network] + traefik_network_list %}
  {{ net }}:
    external: true
{% endfor %}

volumes:
  letsencrypt:
